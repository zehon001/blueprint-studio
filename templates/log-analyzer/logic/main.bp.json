{
  "version": 3,
  "name": "日志查看器",
  "entry": "bind",
  "graphs": {
    "bind": {
      "nodes": [
        {
          "id": "n_start",
          "type": "event.start",
          "params": {},
          "pinDefaults": {},
          "position": {
            "x": 80,
            "y": 200
          }
        },
        {
          "id": "n_read",
          "type": "system.readFile",
          "params": {},
          "pinDefaults": {
            "path": "assets/sample.log"
          },
          "position": {
            "x": 360,
            "y": 200
          }
        },
        {
          "id": "n_print",
          "type": "system.print",
          "params": {},
          "pinDefaults": {},
          "position": {
            "x": 1240,
            "y": 200
          }
        },
        {
          "id": "n_count",
          "type": "array.length",
          "params": {},
          "pinDefaults": {},
          "position": {
            "x": 960,
            "y": 220
          }
        },
        {
          "id": "n_parse",
          "type": "convert.androidLogParse",
          "params": {},
          "pinDefaults": {},
          "position": {
            "x": 660,
            "y": 220
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "kind": "exec",
          "from": {
            "node": "n_start",
            "pin": "exec"
          },
          "to": {
            "node": "n_read",
            "pin": "exec"
          }
        },
        {
          "id": "e2",
          "kind": "exec",
          "from": {
            "node": "n_read",
            "pin": "exec"
          },
          "to": {
            "node": "n_print",
            "pin": "exec"
          }
        },
        {
          "id": "d1",
          "kind": "data",
          "from": {
            "node": "n_read",
            "pin": "text"
          },
          "to": {
            "node": "n_parse",
            "pin": "lines"
          }
        },
        {
          "id": "d2",
          "kind": "data",
          "from": {
            "node": "n_parse",
            "pin": "rows"
          },
          "to": {
            "node": "n_count",
            "pin": "array"
          }
        },
        {
          "id": "d3",
          "kind": "data",
          "from": {
            "node": "n_count",
            "pin": "value"
          },
          "to": {
            "node": "n_print",
            "pin": "value"
          }
        }
      ]
    }
  },
  "variables": [
    {
      "name": "packageName",
      "type": "string",
      "default": "com.demo.app",
      "exposed": true,
      "category": "配置"
    }
  ],
  "events": [],
  "snippets": [],
  "layout": {
    "bind": {
      "zoom": 1,
      "pan": [
        0,
        0
      ]
    }
  }
}
